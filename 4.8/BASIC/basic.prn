  171         03AE      DATYPE	EQU	LOCCRE+1	;03AE	DATENTYP
  172         03AF      DSTMNT	EQU	DATYPE+1	;03AF	DATA-STATEMENS-FLAG
  173         03B0      MEMSIZ	EQU	DSTMNT+1	;03B0	MEMORY SIZE (Speicherende, Anfang Stringraum)
