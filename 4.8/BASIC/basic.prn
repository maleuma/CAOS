  177         03C0      STRDAT	EQU	EOLSPT+1	;03C0	LAENGE UND ADRESSE DES AKTUELLEN STRINGS
  178         03C4      SWAPTR	EQU	STRDAT+4	;03C4	ZEIGER FUER STRINGBEREICH
