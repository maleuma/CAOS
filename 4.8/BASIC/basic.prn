  134         0309      ININD	EQU	OUTIND+1	;0309	IN-Index
  135         030A      TRFLAG	EQU	ININD+1		;030A	TRACE-Flag (0 = AUS)
  136         030B      DIVVAR	EQU	TRFLAG+1	;030B	Schnelle SBC-Routine fuer Gleitkommadivision
