   34                   ;---------------------------------------
   35                   
   36                   ; Steuerzeichen:
   37                   
   38         000A      LF	EQU	0AH
   39         000D      CR	EQU	0DH
   40         001B      ESC	EQU	1BH
   41                   
   42                   ;---------------------------------------
   43                   
   44                   ; Portadressen im Grundgeraet:
   45                   
   46         0088      PIOAD	EQU	88H	; System-PIO Datenbyte Port A
   47                   			;	Bit 0 - CAOS ROM-E ein/aus
   48                   			;	Bit 1 - RAM0 ein/aus
   49                   			;	Bit 2 - IRM ein/aus
   50                   			;	Bit 3 - Schreibschutz RAM0
   51                   			;	Bit 4 - CAOS-ROM 3.5 oder 3.1 (/NMI)
   52                   			;	Bit 5 - System-LED
   53                   			;	Bit 6 - Motorschaltspannung
   54                   			;	Bit 7 - USER-ROM ein/aus
   55         0089      PIOBD	EQU	89H	; System-PIO Datenbyte Port B
   56                   			;	Bit 0 \
   57                   			;	Bit 1  \
   58                   			;	Bit 2   - Lautstaerke Tonausgabe
   59                   			;	Bit 3  /  5 Bit (Low-aktiv)
   60                   			;	Bit 4 /
   61                   			;	Bit 5 - USER-ROM-Ebene Bit 0
   62                   			;	Bit 6 - USER-ROM-Ebene Bit 1
   63                   			;	Bit 7 - Blinken ein/aus
   64         008A      PIOAS	EQU	8AH	; System-PIO Steuerbyte Port A
   65         008B      PIOBS	EQU	8BH	; System-PIO Steuerbyte Port B
   66         008C      CTC0	EQU	8CH	; CTC Kanal 0 (Tonhoehe 1)
   67         008D      CTC1	EQU	8DH	; CTC Kanal 1 (Kassettenausgabe)
   68         008E      CTC2	EQU	8EH	; CTC Kanal 2 (Tondauer)
   69         008F      CTC3	EQU	8FH	; CTC Kanal 3 (Tastatur)
   70                   
   71                   ;---------------------------------------
   72                   
   73                   ; Belegung Systembereich im RAM0:
   74                   
   75                   ; 0000-000Ah	Dateiname
   76                   ; 000Bh		Interrupt-Mode fuer USB (von M052-Software verwaltet)
   77                   ; 000C-000Fh	Datums-Stempel fuer Dateifunktion von USB (MS-DOS-Format)
   78                   ; 0010-00ADh	Arbeitszellen Systemsoftware
   79                   ; 00AE-00E0h	Interrupt-Routine von USB-Modul
   80                   ; 00E1-0107h	Arbeitszellen Systemsoftware
   81                   ; 0108-012Fh	Tasten-UP von CALC (bei Aktivierung mit %?i)
   82                   ; 0180-019Ch	temporaere Ladeadresse der Datei *.JOY ab CAOS 4.6
   83                   ; 0180-01C3h	Systemstack
   84                   
   85         01C4      STACK	EQU	01C4H	; Systemstack
SLR180 SuperFast Relocating Macro Assembler     			    SLR180 1.31 Page   3
EQU35   INC

   86                   
   87                   ; 01C4-01EFh	Interrupttabelle
   88                   ; 01F0-01FFh	IX-Arbeitszellen (Standard: IX=01F0h)
   89                   
   90                   ; Belegung der IX - Zellen:
   91                   
   92                   ; IX+0	Zeitkonstante fuer Kassettenroutinen
   93                   ; IX+1	Merkzelle fuer Ausgabeport 84H
   94                   ; IX+2	gelesene Blocknummer (Kassette)
   95                   ; IX+3	erwartete Blocknummer (Kassette)
   96                   ; IX+4	Merkzelle fuer Ausgabeport 86H
   97                   ; IX+5	Ein- Ausgabepufferadresse (low)
   98                   ; IX+6	Ein- Ausgabepufferadresse (high)
   99                   ; IX+7	Kennbyte fuer LOAD/VERIFY
  100                   ;	 BIT 0: =1 ->LOAD  =0 ->VERIFY
  101                   ;	 BIT 1: =1 kein Selbstart bei LOAD (in BASIC Kennung fuer 1. Block)
  102                   ;	 BIT 2-4 : Anzahl Argumente (bei SAVE)/ARGN>3 (Startoffset)
  103                   ;	 BIT 5: Blocknummern 0=anzeigen, 1=unterdruecken
  104                   ;	 BIT 6-7 : BASIC: fuer CLOAD/CSAVE 
  105                   ; IX+8	Kennbyte Tastatur
  106                   ;	 BIT 0: gueltiges Byte (ASCII) in IX+13
  107                   ;	 BIT 1: Tonausgabe laeuft
  108                   ;	 BIT 2-4: aktuelles Speichergeraet
  109                   ;		  0=Kassette, 1=Diskette, 2=USB (M052), 3=Netzwerk (M052)
  110                   ;		  4=Headersave, 5..7 frei
  111                   ;	 BIT 5: Tastenclick ein/aus
  112                   ;	 BIT 6: Code kommt von F-Taste
  113                   ;	 BIT 7: 0=Shiftlock
  114                   ; IX+9	Prologbyte (normal 7FH)
  115                   ; IX+10	Autorepeatzaehler (Tastatur)
  116                   ; IX+11	Merkzelle fuer Akku (bei BWS on/off mit Stackverlagerung)
  117                   ;	und Pruefsummenberechnung fuer MB-Eingabe
  118                   ; IX+12	7-Bit-Scancode von Tastatur
  119                   ; IX+13	ASCII-Code von Tastatur
  120                   ; IX+14	Tastaturcodetabelle low
  121                   ; IX+15	Tastaturcodetabelle high
  122                   
