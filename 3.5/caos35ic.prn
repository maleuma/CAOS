  126         0309      ININD	EQU	0309H	; IN-Index
  127         031B      RNDVR3	EQU	031BH	; Zufallszahl
  128         034E      ANF	EQU	034EH	; erste Zeilennummer
  129         0350      ENDE	EQU	0350H	; letzte Zeilennummer
  130         0352      NANF	EQU	0352H	; neue erste Zeilennummer
  131         0354      DISTAN	EQU	0354H	; Zeilennummernabstand
  132         035E      DATFLG	EQU	035EH	; List-, Editierschutz wenn <> 0
  133         035F      PSTBEG	EQU	035FH	; Programmstartadresse (Standardwert = 0401H)
  134         037E      COLRET	EQU	037EH	; Ablage Farbbyte
  135         03C0      STRDAT	EQU	03C0H	; 4 Byte: Laenge und Adresse des aktuellen Strings
  136         03D7      SVARPT	EQU	03D7H	; Adresse der Liste der einfachen und Stringvariablen
  137         03EA      INTPRB	EQU	03EAH	; Druckpuffer=Dateiname
  138         03FD      PRTFLG	EQU	03FDH	; PRINT-Erweiterung
  139                   
  140                   ; IRM-Belegung:
  141                   
  142                   ;	EQU	8000H	; PIXEL-RAM
  143                   ;	EQU	0A800H	; COLOR-RAM
