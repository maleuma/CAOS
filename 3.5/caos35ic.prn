  178         B7AC      CCTL3	EQU	0B7ACH	;	"	 3 80H...9FH und E0H...FFH
  179         B7AE      SYSP	EQU	0B7AEH	; System Stackpointer
  180         B7B0      SUTAB	EQU	0B7B0H	; Adresse der Unterprogrammtabelle
