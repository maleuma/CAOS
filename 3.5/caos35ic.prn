  185         B7BD      UOUT1	EQU	0B7BDH	; Sprung zu USER-Ausgabekanal 2 (Drucker)
  186         B7C0      UIN1	EQU	0B7C0H	; Sprung zu USER-Eingabekanal 2
  187         B7C3      UOUT2	EQU	0B7C3H	; Sprung zu USER-Ausgabekanal 3 V.24-duplex
  188         B7C6      UIN2	EQU	0B7C6H	; Sprung zu USER-Eingabekanal 3 V.24-duplex
  189         B7C9      IOERR	EQU	0B7C9H	; Reaktionsprogramm fuer BASIC I/O-Error bis CAOS 4.7
  190         B7CB      BSYSP	EQU	0B7CBH	; Ablage SP bei IRMON (KC85/4: aktuelle VRAM-Adresse)
  191         B7CD      ZOTAB	EQU	0B7CDH	; Zwischenspeicher fuer OUTAB
  192         B7CF      ZWEND	EQU	0B7CFH	; Zwischenspeicher fuer WEND
  193         B7D1      FTAST	EQU	0B7D1H	; F-Tastenpointer
  194         B7D3      HOR	EQU	0B7D3H	; Grafik Horizontalposition (X-Wert)
  195         B7D5      VERT	EQU	0B7D5H	; Grafik Vertikalposition (Y-Wert)
  196         B7D6      FARB	EQU	0B7D6H	; Grafik Farbe
  197                   		; Bit 0=1	XOR-Funktion
  198                   		; Bit 1=1	Punkt loeschen
  199                   		; Bit 2=1	Farbebene nicht veraendern
  200                   		; Bit 3-7	Vordergrundfarbe + Blinken
  201         B7D7      MIXIT	EQU	0B7D7H	; IX-Merker (H-Teil von IX und I-Tabelle)
