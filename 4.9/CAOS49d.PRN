 1596                   ;
 1597                   ; Portinitialisierungstabelle fuer Erstinitialisierung (POWER ON und RESET):
 1598                   ;
 1599                   ; Bei Erstinitialisierung des PIO-Port-A muss sichergestellt werden, dass der
 1600                   ; CAOS-ROM-E immer im Zugriff bleibt. Im Einschaltzustand sind die PIO-Ports
 1601                   ; hochohmig und werden ueber Pull-Up-Widerstaende auf High gezogen, deshalb:
 1602                   ; 1. PIO-Port B initialisieren, und PIO damit aus dem RESET-Zustand holen
 1603                   ;    (so wird auch das Ausgaberegister von Port A beschreibbar)
 1604                   ; 2. Port A Datenwort einschreiben
 1605                   ; 3. Port A Betriebsart Byte-Ausgabe einstellen um das Datenwort zu uebernehmen.
 1606                   ; Der RESET-Impuls zur D005-Tastatur wirkt nur, wenn die PIO bereits vorher
 1607                   ; auf Byte-Ausgabe initialisiert ist (also nur bei RESET, nicht bei POWER-ON)
 1608                   ;
 1609 D96C  06          IOTAB1:	DB	6		; 6 Ports fuer Erstinitialisierung
 1610                   
 1611 D96D  8B 03       	 DB	PIOBS,3		; PIO-B Steuerwort
 1612 D96F  E6          	  DB	0E6h		; Interruptvektor
 1613 D970  0F          	  DB	00001111b	; Byte-Ausgabemodus
 1614 D971  83          	  DB	10000011b	; EI
 1615                   
 1616 D972  89 01       	 DB	PIOBD,1		; PIO-B Daten
 1617 D974  FF          	  DB	11111111b	; Blinken ein, RAM8 WR, Lautstaerke 0
 1618                   
 1619 D975  88 02       	 DB	PIOAD,2		; PIO-A Daten
 1620 D977  1F          	  DB	00011111b	; D005-Reset (KOUT 1-Impuls)
 1621 D978  0F          	  DB	00001111b	; IRM ein, RAM0 WR ein, CAOS-E ein, USER-ROM aus
 1622                   
 1623 D979  8A 03       	 DB	PIOAS,3		; PIO-A Steuerwort
 1624 D97B  E4          	  DB	0E4h		; Interruptvektor
 1625 D97C  0F          	  DB	00001111b	; Byte-Ausgabemodus
 1626 D97D  03          	  DB	00000011b	; DI
 1627                   
 1628 D97E  84 01       	 DB	PORT1,1		; Ausgabeport 84h
 1629 D980  28          	  DB	00101000b	; RAM8 0, LoRes
 1630                   
 1631 D981  86 01       	 DB	PORT2,1		; Ausgabeport 86h
 1632 D983  E3          	  DB	11100011b	; RAM4 ein, USER-C 3, CAOS-C ein
