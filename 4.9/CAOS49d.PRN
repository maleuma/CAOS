   38                   ; !!! Versionsdatum nur noch in VORBL49.INC eintragen !!!
   39                   
   40         0000      BETA	equ	0		; 0 fuer Vollversion, 1 fuer beta-Version
   41                   	;benoetigt 1 Byte im ROM C
   42                   
   43                   ; Die Bits 2, 3 und 4 von Port2 (86h) sind beim KC85/4 nicht benutzt worden.
   44                   ; Fuer eine Nutzung beim KC85/5 gibt es mehrere Ideen/Optionen. Diese sind
   45                   ; untereinander nicht kompatibel. CAOS 4.8 ist zur Nutzung des 512K-Flash-ROM
   46                   ; mit Zeichensatz-Umschaltung vorbereitet. Die Erweiterung des RAM bzw. USER-ROM
   47                   ; ist dadurch nicht mehr vorgesehen. Wenn kein Flash-ROM installiert ist, kann
   48                   ; aber trotzdem durch nachgeladene Treiber z.B. der RAM mit 1 oder 2 MByte
   49                   ; genutzt werden. Die einzelnen Optionen nutzen folgende Bits:
   50                   ;
   51                   ; Option  234	Beschreibung
   52                   ; RAM1MB  xx-	Erweiterung des internen RAM auf 1MByte
   53                   ; RAM2MB  xxx	Erweiterung des internen RAM auf 2MByte
   54                   ; USER8   --x	Erweiterung des USER-ROM von 4 auf 8 Ebenen
   55                   ; CAOS2   --x	Zeichensatz-Umschaltung durch zweite CAOS-ROM-Ebene
   56                   ; SYSROM  xx-	Ansteuerung eines 512K Flash-ROM mit 8 CAOS-Versionen
SLR180 SuperFast Relocating Macro Assembler     			    SLR180 1.31 Page   2
CAOS49  Z80

   57                   
   58         0001      CAOS2	EQU	1		; Erweiterung zur Umschaltung des Zeichensatzes
   59                   	;benoetigt 8 Byte im ROM C
   60                   ; Diese Erweiterung setzt einen 16K grossen CAOS-ROM-C und einen 16K grossen
   61                   ; CAOS-ROM-E voraus. In der ersten Haelfte der ROM's wird das System mit dem
   62                   ; duennen Zeichensatz gebrannt, in der zweiten Haelfte der Standard-Zeichensatz.
   63                   ; Umgeschaltet wird mit Bit 4 von Port 86h (IX+4) bzw. SWITCH 5 10
   64                   
   65         0001      SYSROM	EQU	1		; Erweiterung fuer 8 Ebenen System-ROM
   66                   	;benoetigt 29 Byte im ROM C
   67                   	;benoetigt 5 Byte im ROM F
   68                   ; Diese Erweiterung setzt je einen Flash-ROM mit 8 CAOS-Versionen voraus.
   69                   ; Ueber die Bits 2 und 3 des Port 86h wird ein Zaehler initiiert, welcher die
   70                   ; aktuelle Ebene speichert und diese als Adresse an den Flash-ROM weiter gibt.
   71                   ; Ein H-Impuls an Bit 3 (86h) bei Bit 2=High setzt den Zaehler zurueck
   72                   ; Ein H-Impuls an Bit 3 (86h) bei Bit 2=Low zaehlt den Zaehler vorwaerts
   73                   ;
   74                   ; Umgeschalten werden die System-Ebenen mit JUMP 0 bis 7
   75                   
   76         0001      EX81	EQU	1		; erweitertes Steuerbyte Portadresse 81h
   77                   	;benoetigt 37 Byte im ROM-C
   78                   ; Diese Erweiterung gestattet die Steuerung von Modulen ueber ein 16 Bit breites
   79                   ; Steuerbyte. 8 Bit mit Portadresse 80h und 8 Bit ueber Portadresse 81h
   80                   ;
   81                   ; SWITCH mm ssss	SWITCH-Kommando 16 Bit
   82                   ;	Steuerbyte in Doppelregister DE
   83                   ; UP MODU = 26H
   84                   ; PE:	A=1	Modultyp lesen (Register L)
   85                   ;	A=2	Modul schalten (Register DE und L)
   86                   ;	L	Modulsteckplatz
   87                   ;	DE	Modulsteuerbyte neu
   88                   ; PA:	H	Modultyp (Strukturbyte)
   89                   ;	D	Modulsteuerbyte neu
   90                   ;	A	Modulsteuerbyte alt
   91                   ; VR:	AF, D, H, BC
   92                   ; Modul-Liste 16 Bit
   93                   ; Ablage der hohen 8 Bit im Adressbereich B800H XOR 80H, also
   94                   ; Steckplatz  8 auf B808h und B888h
   95                   ; Steckplatz  C auf B80Ch und B88Ch
   96                   ; ...
   97                   ; Steckplatz F0 auf B8F0h und B870h
   98                   ; Das sollte funktionieren, da es nie 7 D002 im KC-System geben wird.
   99                   ; -----------------------------------------------------------------------------
  100                   ; Uebersetzen ohne Erzeugen eines Listings:
  101                   ;	SLRZ80 CAOS49.@@Z/F
  102                   ; oder:	Z80ASM CAOS49.@@Z/F
  103                   ;	REN CAOS49.COM CAOS49.KCC
  104                   
  105                   ; Uebersetzen mit Erzeugen eines Listings:
  106                   ;	SLRZ80 CAOS49/F
  107                   ; oder:	Z80ASM CAOS49/F
  108                   ;	REN CAOS49.COM CAOS49.KCC
  109                   
  110                   ; Hardware:	KC85/5 oder KC85/5+ (mit Flash-ROM)
  111                   ;
  112                   ;256 KByte interner RAM (RAM0,RAM4,RAM8)
  113                   ; 64 KByte IRM (2 unabhaengige Bilder)
  114                   ; 16 KByte CAOS-ROM C000-FFFF (2 Ebenen, Zeichensatz-Umschaltung)
SLR180 SuperFast Relocating Macro Assembler     			    SLR180 1.31 Page   3
