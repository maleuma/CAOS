  923 F4E7  E6 DF       	AND	11011111b	; klein -> gross    D9..DF 00..1F 00..1F 40..9E
  924 F4E9  C6 0A       	ADD	10		; kleiner als 'A'   E3..E9 0A..29 0A..29 4A..A8
