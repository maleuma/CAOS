  718                   
  719         0001      IF EX81
  720                   ; Module lesen und schalten
  721                   ; PE:	A=0 oder A=1	Lesen
  722                   ;	A=2		Schalten 8 Bit
  723                   ;	A=3 oder >3	Schalten 16 Bit
  724                   ;	L	Modulsteckplatz
  725                   ;	D	Modulsteuerbyte      80h (bei A=2)
  726                   ;	E	erw. Modulsteuerbyte 81h (bei A=3)
  727                   ; PA:	H	Modultyp (Strukturbyte)
  728                   ;	D	Modulsteuerbyte neu
  729                   ;	A	Modulsteuerbyte alt (bei A=2)
  730                   ;	BC	Modulsteuerbyte alt (bei A=3)
  731                   ; VR:	AF, D, H, BC
  732                   
  733 C3F0  26 B8       MODUC:	LD	H,HIGH(MODST)	; Modulsteuerbytespeicher
  734 C3F2  4E          	LD	C,(HL)		; Schaltzustand (L) lesen
  735 C3F3  E5          	PUSH	HL
  736 C3F4  CB 15       	RL	L
  737 C3F6  3F          	CCF			; Wechsel in zweite Haelfte von MODST
  738 C3F7  CB 1D       	RR	L
  739 C3F9  46          	LD	B,(HL)		; Schaltzustand (H) lesen
  740 C3FA  E1          	POP	HL
