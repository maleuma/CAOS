  433                   ; Menue anzeigen und Uebergang zur Kommandoeingabe
  434                   ; PE:	(IX+9)	Prologbyte
  435                   ;	ARGN=1	ARG1 auswerten
  436                   ;	ARG1=0	MENU normal anzeigen
