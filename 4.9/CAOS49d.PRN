 2556 CD71  D5          	PUSH	DE
 2557 CD72  11 00A0     	LD	DE,160		; kurze Vortonlaenge normal
 2558 CD75  20 03       	JR	NZ,NOHIU
 2559 CD77  11 0500     	LD	DE,1280		; bei 'U' gedehnt
 2560 CD7A  ED 53 B7D8  NOHIU:	LD	(VORTN),DE
 2561 CD7E  CD D80A     	CALL	BNAME		; Dateiname konvertieren/merken fuer ISRO
 2562 CD81  CD E4C9     	CALL	CLC		; Kassettenpuffer loeschen
 2563 CD84  CD ED3B     	CALL	DEV		; Kassette?
 2564 CD87  20 05       	JR	NZ,MBONN	; nein
 2565 CD89  01 000B     	LD	BC,11		; Laenge Dateiname + Typ
 2566 CD8C  ED B0       	LDIR			; bei TAPE zunaechst mit Name fuellen
 2567 CD8E  EB          MBONN:	EX	DE,HL		; HL jetzt Zeiger in Puffer
 2568 CD8F  D1          	POP	DE
 2569 CD90  72          	LD	(HL),D		; 1. Datenbyte eintragen
 2570 CD91  2C          	INC	L
 2571 CD92  7D          MBOC1:	LD	A,L
 2572 CD93  32 B7DA     MBOC0:	LD	(DTPTR),A	; Zeiger neu setzen
 2573 CD96  A7          MBOCE:	AND	A		; CY=0 / kein Fehler (zusaetzlich ab CAOS 4.7)
 2574 CD97  C1          MBCERR:	POP	BC
SLR180 SuperFast Relocating Macro Assembler     			    SLR180 1.31 Page  54
CC49    INC

 2575 CD98  D1          	POP	DE
 2576 CD99  CB 9B       	RES	3,E		; Init zuruecksetzen
 2577 CD9B  C9          	RET
 2578                   	;
 2579 CD9C  2A B7DA     NOINIT:	LD	HL,(DTPTR)	; Zeiger holen
 2580 CD9F  26 B7       	LD	H,High(CASS)	; und mit Kassettenpuffer verbinden
 2581 CDA1  72          	LD	(HL),D		; Datenbyte eintragen
 2582 CDA2  CB 73       	BIT	6,E		; Close?
 2583 CDA4  20 26       	JR	NZ,MCLOS	; letzten Block schreiben
 2584 CDA6  2C          	INC	L		; Zeiger auf naechste Position
 2585 CDA7  F2 CD92     	JP	P,MBOC1		; Puffer noch nicht voll
 2586 CDAA  DD CB 07 4E 	BIT	1,(IX+7)	; steht INIT noch aus?
 2587 CDAE  20 0A       	JR	NZ,MBOC2	; ja, dann erst einmal den Vorblock ausgeben!
 2588 CDB0  CD CEC0     	CALL	MBLO		; Datenblock ausgeben, Blocknummer anzeigen
 2589 CDB3  38 E2       	JR	C,MBCERR	; BRK oder Fehler -> IO-Error
 2590 CDB5  CD E4C9     MBOC6:	CALL	CLC		; Kassettenpuffer jetzt wieder loeschen
 2591 CDB8  18 D9       	JR	MBOC0		; Zeiger zuruecksetzen
 2592                   	;
 2593 CDBA  DD CB 07 8E MBOC2:	RES	1,(IX+7)	; INIT ruecksetzen
 2594 CDBE  21 B7F5     	LD	HL,FNAME	; Dateiname fuer Ausgabe
 2595 CDC1  CD E4D2     	CALL	PV7
 2596 CDC4  02          	DB	2		; Vorblock ausgeben mit ISRO
 2597                   ;	JR	C,MBCERR	; Fehler
 2598 CDC5  D4 CEC9     	CALL	NC,MBLO1	; Blocknummer anzeigen, neue Zeile, BRK-Test
 2599 CDC8  38 CD       	JR	C,MBCERR	; BRK oder Fehler
 2600 CDCA  18 E9       	JR	MBOC6		; Zeiger auf leeren Puffer stellen
 2601                   
 2602                   ; Close:
 2603 CDCC  DD CB 07 4E MCLOS:	BIT	1,(IX+7)	; steht noch INIT aus?
 2604 CDD0  28 09       	JR	Z,MBOC3		; nein, nur noch der Endeblock
 2605 CDD2  21 B7F5     	LD	HL,FNAME	; Dateiname fuer Ausgabe
 2606 CDD5  CD E4D2     	CALL	PV7
 2607 CDD8  02          	DB	2		; sonst erst noch ISRO ausfuehren
 2608 CDD9  18 07       	JR	MBOC4		; und danach sofort Close
 2609                   ;
 2610                   ; 17.02.2019
 2611                   ; Bei der byteweisen Ausgabe wurde bisher der Endeblock immer 2x ausgegeben.
 2612                   ; Dateien auf Diskette und USB-Laufwerken sind deshalb immer einen Block zu lang
 2613                   ;
 2614                   ; 24.11.2020
 2615                   ; Offenbar wurde dieses Verhalten mit Absicht eingebaut, denn BASIC benoetigt
 2616                   ; nach Einlesen des letzten Datenbytes eine gewisse "Bedenkzeit" bevor das Close
 2617                   ; zum Lesen des Endebytes 03h folgt. Wird also der erste Ende-Block nicht
 2618                   ; erwischt, dann folgt noch ein weiterer. Ohne diesen zusaetzlichen Block bleibt
 2619                   ; BASIC beim Lesen haengen und man muss zurueckspulen und den letzten Block
 2620                   ; nochmals abspielen.
 2621                   ; -> Also wird bei TAPE der Endeblock weiterhin 2x nacheinander ausgegeben.
 2622                   ;
 2623 CDDB  CD ED3B     MBOC3:	CALL	DEV		; Kassette?
 2624 CDDE  CC CEC0     	CALL	Z,MBLO		; bei TAPE letzten Block als Datenblock ausgeben
 2625 CDE1  D8          	RET	C		; BRK oder Fehler
 2626 CDE2  ED 4B B7D8  MBOC4:	LD	BC,(VORTN)
 2627 CDE6  CD E4D2     	CALL	PV7
 2628 CDE9  03          	DB	3		; Endeblock ausgeben mit CSRO
 2629 CDEA  CD F37E     	CALL	CRLF
 2630 CDED  18 04       	JR	MBRES		; fertig (CY=1 bei Fehler)
 2631                   ;
 2632 CDEF  CD E4D2     MBICL:	CALL	PV7
SLR180 SuperFast Relocating Macro Assembler     			    SLR180 1.31 Page  55
CC49    INC

 2633 CDF2  05          	DB	5		; Dateieingabe stoppen mit CSRI
 2634 CDF3  DD CB 07 AE MBRES:	RES	5,(IX+7)	; 'U'-Merker ruecksetzen (Blocknummern anzeigen)
 2635 CDF7  18 9E       	JR	MBCERR		; fertig
 2636                   
 2637                   ; Byteeingabe von Datentraeger (BASIC-Schnittstelle)	**37**
 2638                   
 2639                   ; Zunaechst Daten aus Puffer entnehmen und nur wenn Puffer leer ist in die
 2640                   ; MBIN-Routine(n) des eingestellten Treibers springen
 2641                   
 2642                   ; PE:	D	Steuerbyte
 2643                   ;		Bit 3 = 1 INIT (Block 01)
 2644                   ;		Bit 6 = 1 Close (Block FF)
 2645                   ;	HL	Name nur bei INIT (Adresszeiger 11 Byte)
 2646                   ; PA:	A	Datenbyte
 2647                   ;	CY=1	Fehler (auch falscher Dateiname bei TAPE)
 2648                   ; VR:	AF, DE, HL
 2649                   ;
 2650 CDF9  5A          MBIC:	LD	E,D		; Steuerbyte
 2651                   ;	LD	D,A		; Datenbyte (PA!)
 2652 CDFA  D5          	PUSH	DE
 2653 CDFB  C5          	PUSH	BC
 2654 CDFC  CB 73       	BIT	6,E		; Close?
 2655 CDFE  20 EF       	JR	NZ,MBICL	; ja, Bandeingabe stoppen
 2656 CE00  CB 5B       	BIT	3,E		; Init?
 2657 CE02  28 64       	JR	Z,MBIU		; nein, Datenbyte holen
 2658                   
 2659                   ; Init Bandeingabe
 2660 CE04  E5          	PUSH	HL		; Dateiname merken
 2661                   ;
 2662                   ; 29.03.2021:
 2663                   ; Dateityp hier schon testen zur Unterdrueckung bei BASIC-Listings *.UUU
 2664                   ; der Test nach dem Einlesen des ersten -blocks funktioniert nur bei TAPE.
 2665                   ;
 2666 CE05  7E          	LD	A,(HL)		; vorangestellter Dateityp: 1. Zeichen testen
 2667 CE06  FE D5       	CP	'U'+80H		; hohes 'U'?
 2668 CE08  20 04       	JR	NZ,MBIC0
 2669 CE0A  DD CB 07 EE 	SET	5,(IX+7)	; merken zur Blocknummernausgabeunterdrueckung
 2670                   				; beim Einlesen von ASCII-Listings
 2671 CE0E  CD D80A     MBIC0:	CALL	BNAME		; Dateiname konvertieren/merken fuer ISRI
 2672 CE11  21 B7F5     	LD	HL,FNAME	; konvertierter Dateiname
 2673 CE14  CD E4D2     	CALL	PV7
 2674 CE17  04          	DB	4		; Block 01h einlesen mit ISRI
 2675 CE18  E1          MBIC1:	POP	HL		; gesuchter Dateiname fuer Vergleich
 2676 CE19  DA CEAE     MBIC2:	JP	C,JBLERR	; Lesefehler: '*'
 2677 CE1C  DD 7E 02    	LD	A,(IX+2)	; gelesener Block
 2678 CE1F  3D          	DEC	A
 2679 CE20  C2 CEAE     	JP	NZ,JBLERR	; falsche Blocknummer: '*'
 2680 CE23  DD CB 07 BE 	RES	7,(IX+7)	; Kopfblock ist geladen
 2681 CE27  DD 34 03    	INC	(IX+3)		; naechster erwarteter Block
 2682 CE2A  11 B700     	LD	DE,CASS		; Daten stehen jetzt im Kassettenpuffer
 2683 CE2D  CD ED3B     	CALL	DEV		; Kassette?
 2684 CE30  20 2B       	JR	NZ,MBINN	; nein, sofort Datenbyte entnehmen
 2685                   	
 2686                   ; Dateiname anzeigen/vergleichen
 2687 CE32  06 0B       	LD	B,11		; Laenge des Dateinamens bei Tape im Kassettenpuffer
 2688 CE34  1A          	LD	A,(DE)		; vorangestellter Dateityp: 1. Zeichen testen
 2689                   ;	CP	'U'+80H		; hohes 'U'?
 2690                   ;	JR	NZ,MBIC3
