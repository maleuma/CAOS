 1722                   	RESIXA	7,4		; RES 7,(IX+4),A
    1 DA12  DD CB 04    	 DB	0DDh,0CBh,4
    2 DA15  BF          	 DB	7 SHL 3 OR 10000111b
 1723 DA16  D3 86       	OUT	(PORT2),A	; CAOS-ROM C aus!
 1724 DA18  D5          	PUSH	DE
 1725 DA19  CB 43       	BIT	0,E		; war CAOS-ROM C ein waehrend erster Suche?
 1726 DA1B  20 04       	JR	NZ,HELP3	; ja, dann USER-ROM komplett anzeigen
 1727 DA1D  3A B780     	LD	A,(ARGC)	; USER-ROM
 1728 DA20  BA          	CP	D		; aktuelle Ebene ein waehrend erster Suche?
 1729 DA21  C4 B73C     HELP3:	CALL	NZ,MENX8K	; Menueworte aus USER-ROM anzeigen
 1730 DA24  D1          	POP	DE
 1731 DA25  3E 10       	LD	A,10H		; Offset zur naechsten Ebene: C1, D1, E1, F1
 1732 DA27  82          	ADD	A,D		; naechste Ebene berechnen
 1733 DA28  57          	LD	D,A
 1734 DA29  30 E4       	JR	NC,HELP2
