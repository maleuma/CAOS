  438                   ;	ARG1=2	Adressen mit anzeigen
  439                   ;	ARGN=3	versteckte Menueworte und Adressen anzeigen
  440                   ; PA/VR: -
  441                   
  442 F22C  E1          MENU:	POP	HL		; Stack clear
  443 F22D  21 C000     	LD	HL,0C000H	; Menuewortsuche immer ab C000H
  444 F230  ED 5B B781  	LD	DE,(ARGN)	; D=(ARG1), E=(ARGN)
