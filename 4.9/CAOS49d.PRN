CD49    INC

   13                   ;*******************************************************************************
   14                   
   15                   ; Zeitkonstanten fuer TAPE-Schreiben:
   16                   			; Vorton	"1"-Bits
   17         005D      ZKKAT	EQU	93	; Trennzeichen	Vollschwingung ca.  557 Hz
   18         0017      ZKKA0	EQU	23	; "0"		Vollschwingung ca. 1950 Hz
   19         002F      ZKKA1	EQU	47	; "1"		Vollschwingung ca. 1050 Hz
   20                   
   21                   ; Zeitkonstanten fuer TAPE-Lesen:
   22         00A3      IKEZK	EQU	163	; Zeitkonstante fuer CTC
   23         005D      IKEGN	EQU	93	; Erkennung Nullbit
   24         00BA      IKEG1	EQU	186	; Erkennung Einsbit
   25                   
   26                   ; Initialisierung Bandausgabe:				**08**
   27                   ; PA:	CY=0	(kein Fehler bei Bandausgabe)
   28                   
   29 D040  F3          TISRO:	DI
   30 D041  DB 88       	IN	A,(PIOAD)
   31 D043  F6 60       	OR	01100000b	; Motor+LED ein
   32 D045  CD E462     	CALL	ISRO1		; Initialisierung
   33 D048  DD 36 02 00 	LD	(IX+2),0	; Block 1 (Vorblock)
