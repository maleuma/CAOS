 1634                   ; Initialisierungstabelle fuer M001 als Centronics-Druckerschnittstelle:
 1635                   ;
 1636 D984  03          DIOINI:	DB	3
 1637 D985  06 02       	 DB	06h,2		; PIO-A Steuerwort
 1638 D987  CF          	  DB	11001111b	; Bitbetrieb
 1639 D988  00          	  DB	00000000b	; alles Ausgaenge
 1640 D989  07 02       	 DB	07h,2		; PIO-B Steuerwort
 1641 D98B  CF          	  DB	11001111b	; Bitbetrieb
