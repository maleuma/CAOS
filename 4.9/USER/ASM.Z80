TITLE	KC-Assembler
;----------------------------------------------------------------
;		Assembler-Ebene im USER-ROM CAOS 4.9		I
;		---------------					I
;								I
; enthaelt:	BASIC-Verteiler	mit Fullscreen-Editor		I
;		Assembler					I
;								I
;		(c) ML-Soft 27.03.2023 - 27.03.2023		I
;----------------------------------------------------------------
	.Z80
;-------

; CAOS-Vorblock:
	DB	'ASM22   KCC'	; 11 Byte Dateiname
	DS	5,0
	DB	2		; 2 Argumente
	DW	ROMBEG		; Anfangsadresse
	DW	ROMEND		; Endadresse
	DW	0
	DS	95,0
	DB	'15.02.2024'	; Datum
;---------------
	.PHASE	0C000H
ROMBEG:
	INCLUDE	BASPV.INC	; BASIC-IO-Routinen mit Fullscreen-Editor
	INCLUDE	ASM22.Z80	; Assembler
	INCLUDE	CAOSEX49.INC	; SETRO, SETWR, TIME, PRINT

	ABSFILL	0E000h,<USER-ROM-Ende (ASM)>
ROMEND:

	.DEPHASE
	END
